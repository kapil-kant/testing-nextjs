{
  "name": "testing-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:development": "rm -rf .next && env-cmd -f .env.local next dev",
    "dev:production": "env-cmd -f .env.prod next dev",
    "dev:stage": "env-cmd -f .env.stage next dev",
    "dev": "next dev",
    "turbo": "next dev --turbo",
    "build:development": "env-cmd -f .env.local next build",
    "build:production": "env-cmd -f .env.prod next build",
    "prebuild:stage": "npm run test:ci",
    "build:stage": "env-cmd -f .env.stage next build",
    "build-stats": "cross-env ANALYZE=true next build",
    "build:local": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "preview": "next build && next start",
    "prepare": "husky install",
    "test": "jest",
    "test:ci": "jest --ci --coverage=false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.15",
    "@arco-themes/react-easy-email-theme": "^0.0.3",
    "@date-io/dayjs": "^2.17.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/base": "^5.0.0-beta.33",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/x-date-pickers": "6.20.2",
    "@react-pdf/renderer": "4.5.1",
    "@reduxjs/toolkit": "^1.9.7",
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "easy-email-core": "4.17.1",
    "easy-email-editor": "4.17.1",
    "easy-email-extensions": "4.17.1",
    "env-cmd": "^10.1.0",
    "file-saver": "^2.0.5",
    "firebase": "10.14.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.548.0",
    "mjml-browser": "4.18.0",
    "moment": "^2.30.1",
    "moment-timezone": "0.6.2",
    "next": "14.2.35",
    "next-auth": "4.24.14",
    "next-redux-wrapper": "^8.1.0",
    "next-share": "^0.27.0",
    "react": "18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-hubspot-form": "^1.3.7",
    "react-image-file-resizer": "^0.4.8",
    "react-multi-carousel": "2.8.6",
    "react-quill": "^2.0.0",
    "react-redux": "8.1.3",
    "react-toastify": "^10.0.3",
    "react-use": "^17.6.0",
    "react-window": "^1.8.10",
    "redux-persist": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/luxon": "^3.7.1",
    "@types/mjml-browser": "^4.15.0",
    "@types/node": "^20.3.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/react-google-recaptcha": "^2.1.8",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "autoprefixer": "10.5.2",
    "cross-env": "^7.0.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "14.2.35",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^8.0.3",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.16",
    "prettier": "^2.8.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --no-eslintrc --no-inline-config --config .eslintrc.precommit.json --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "supports es6-module"
  ]
}
